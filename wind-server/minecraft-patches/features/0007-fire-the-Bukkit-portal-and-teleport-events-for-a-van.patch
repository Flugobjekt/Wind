     }
 
+    // Wind start - the three values Paper hands PlayerPortalEvent, computed the way Paper
+    // computes them, so the event this fork restores says the same thing Paper's does. They live
+    // next to portalToAsync rather than in the compat class because they read the platform's own
+    // portal configuration, and they deliberately mirror what findOrCreatePortalAsync below
+    // computes for itself - if those two ever disagree, the event is lying about the destination.
+    private Vec3 windApproximatePortalExit(final ServerLevel destination, final PortalType type) {
+        if (type == PortalType.END) {
+            // Fixed on both sides: the end spawn going in, the destination's stored respawn
+            // position coming out. A player lands one block lower, as the platform's own end
+            // branch does.
+            final BlockPos target = destination.getTypeKey() == net.minecraft.world.level.dimension.LevelStem.END
+                ? ServerLevel.END_SPAWN_POINT
+                : destination.getRespawnData().pos();
+            return Vec3.atBottomCenterOf(this instanceof net.minecraft.world.entity.player.Player ? target.below() : target);
+        }
+        // Nether: the entity's position scaled by the dimension ratio and clamped to the
+        // destination's border. Paper reports this as a block position, so this does too.
+        final double scale = net.minecraft.world.level.dimension.DimensionType.getTeleportationScale(
+            this.level().dimensionType(), destination.dimensionType());
+        return Vec3.atLowerCornerOf(destination.getWorldBorder().clampToBounds(
+            this.getX() * scale, this.getY(), this.getZ() * scale));
+    }
+
+    private int windPortalSearchRadius(final ServerLevel destination, final PortalType type) {
+        if (type != PortalType.NETHER) {
+            return 0; // Paper passes 0 for an end portal: there is nothing to search for.
+        }
+        final boolean destinationIsNether = destination.getTypeKey() == net.minecraft.world.level.dimension.LevelStem.NETHER;
+        return this.level().paperConfig().environment.portalSearchVanillaDimensionScaling && destinationIsNether
+            ? (int) (destination.paperConfig().environment.portalSearchRadius / destination.dimensionType().coordinateScale())
+            : destination.paperConfig().environment.portalSearchRadius;
+    }
+
+    private int windPortalCreateRadius(final ServerLevel destination, final PortalType type) {
+        return type == PortalType.NETHER ? destination.paperConfig().environment.portalCreateRadius : 0;
+    }
+
+    private static org.bukkit.PortalType windBukkitPortalType(final PortalType type) {
+        return type == PortalType.NETHER ? org.bukkit.PortalType.NETHER : org.bukkit.PortalType.ENDER;
+    }
+
+    private static org.bukkit.event.player.PlayerTeleportEvent.TeleportCause windPortalCause(final PortalType type) {
+        return type == PortalType.NETHER
+            ? org.bukkit.event.player.PlayerTeleportEvent.TeleportCause.NETHER_PORTAL
+            : org.bukkit.event.player.PlayerTeleportEvent.TeleportCause.END_PORTAL;
+    }
+    // Wind end
