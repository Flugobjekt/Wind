         }
         // Lophine end - destination-driven portal backpressure
 
+        // Wind start - fire the Bukkit portal and teleport events this path routes around.
+        // A portal never reaches Entity#teleportAsync and never reaches Portal#getPortalDestination,
+        // so on stock it fires neither PlayerTeleportEvent nor PlayerPortalEvent while the entity
+        // still crosses worlds. Deliberately here: after canPortalAsync and the Luminol portal
+        // event, before the unload lock and before anything is detached or transformed, so a cancel
+        // is a plain return false with no lock to unwind. See WindPortalEvents.
+        final fun.bm.wind.compat.WindPortalEvents.Outcome windPortal;
+        if (fun.bm.wind.config.modules.EventConfig.portalEvents) {
+            windPortal = fun.bm.wind.compat.WindPortalEvents.callPortalEvents(
